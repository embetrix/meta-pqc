From 3b8cf62fd05cf978bcb8cda2470c7775283f4ad5 Mon Sep 17 00:00:00 2001
From: Ayoub Zaki <ayoub.zaki@embetrix.com>
Date: Sun, 1 Mar 2026 16:20:49 +0100
Subject: [PATCH] Add tls_groups config option and log TLS key exchange info

Add tls_groups config option to specify allowed TLS key exchange groups via
SSL_CTX_set1_groups_list and fall back to OpenSSL default groups when not
specified.

Log TLS version, cipher and negotiated key exchange group on client connection.

Upstream-Status: Pending

Signed-off-by: Ayoub Zaki <ayoub.zaki@embetrix.com>
---
--- a/src/conf.c
+++ b/src/conf.c
@@ -430,6 +430,7 @@
 			mosquitto_FREE(config->listeners[i].keyfile);
 			mosquitto_FREE(config->listeners[i].ciphers);
 			mosquitto_FREE(config->listeners[i].ciphers_tls13);
+			mosquitto_FREE(config->listeners[i].tls_groups);
 			mosquitto_FREE(config->listeners[i].psk_hint);
 			mosquitto_FREE(config->listeners[i].crlfile);
 			mosquitto_FREE(config->listeners[i].tls_version);
@@ -1668,6 +1669,13 @@
 #else
 					log__printf(NULL, MOSQ_LOG_WARNING, "Warning: ciphers_tls1.3 support not available.");
 #endif
+				}else if(!strcmp(token, "tls_groups")){
+#ifdef WITH_TLS
+					if(reload) continue; /* Listeners not valid for reloading. */
+					if(conf__parse_string(&token, "tls_groups", &cur_listener->tls_groups, &saveptr)) return MOSQ_ERR_INVAL;
+#else
+					log__printf(NULL, MOSQ_LOG_WARNING, "Warning: TLS support not available.");
+#endif
 				}else if(!strcmp(token, "clientid") || !strcmp(token, "remote_clientid")){
 #ifdef WITH_BRIDGE
 					REQUIRE_BRIDGE(token);
--- a/src/handle_connect.c
+++ b/src/handle_connect.c
@@ -235,6 +235,34 @@
 				context->id,
 				SSL_get_cipher_version(context->ssl),
 				SSL_get_cipher_name(context->ssl));
+#if OPENSSL_VERSION_NUMBER >= 0x30000000L
+		{
+			int nid = (int)SSL_get_negotiated_group(context->ssl);
+			if(nid != NID_undef && nid != 0){
+				const char *group_name = SSL_group_to_name(context->ssl, nid);
+				if(!group_name) group_name = OBJ_nid2sn(nid);
+				if(!group_name) group_name = "unknown";
+				log__printf(NULL, MOSQ_LOG_NOTICE, "Client %s key exchange group: %s",
+						context->id, group_name);
+			}else{
+				log__printf(NULL, MOSQ_LOG_NOTICE, "Client %s key exchange group: default (not explicitly negotiated)",
+						context->id);
+			}
+		}
+#elif OPENSSL_VERSION_NUMBER >= 0x10101000L
+		{
+			int nid = SSL_get_shared_group(context->ssl, 0);
+			if(nid > 0){
+				const char *group_name = OBJ_nid2sn(nid);
+				if(!group_name) group_name = "unknown";
+				log__printf(NULL, MOSQ_LOG_NOTICE, "Client %s key exchange group: %s",
+						context->id, group_name);
+			}else{
+				log__printf(NULL, MOSQ_LOG_NOTICE, "Client %s key exchange group: default",
+						context->id);
+			}
+		}
+#endif
 	}
 #endif
 
--- a/src/mosquitto_broker_internal.h
+++ b/src/mosquitto_broker_internal.h
@@ -251,6 +251,7 @@
 	char *tls_engine_kpass_sha1;
 	char *ciphers;
 	char *ciphers_tls13;
+	char *tls_groups;
 	char *psk_hint;
 	SSL_CTX *ssl_ctx;
 	char *crlfile;
--- a/src/net.c
+++ b/src/net.c
@@ -512,6 +512,18 @@
 		}
 	}
 
+	if(listener->tls_groups){
+#if OPENSSL_VERSION_NUMBER >= 0x10101000L
+		rc = SSL_CTX_set1_groups_list(listener->ssl_ctx, listener->tls_groups);
+		if(rc != 1){
+			log__printf(NULL, MOSQ_LOG_ERR, "Error: Unable to set TLS groups. Check tls_groups \"%s\".", listener->tls_groups);
+			return MOSQ_ERR_TLS;
+		}
+#else
+		log__printf(NULL, MOSQ_LOG_WARNING, "Warning: tls_groups requires OpenSSL >= 1.1.1.");
+#endif
+	}
+
 	return MOSQ_ERR_SUCCESS;
 }
 #endif
--
2.43.0
